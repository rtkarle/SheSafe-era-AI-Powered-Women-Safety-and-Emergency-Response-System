rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dashboard can read all alerts (authenticated)
    match /alerts/{alertId} {
      allow read: if request.auth != null;
      allow write: if false; // backend Admin SDK handles writes
    }

    // Users can only read their own contacts
    match /contacts/{contactId} {
      allow read: if request.auth != null
                  && resource.data.user_id == request.auth.uid;
      allow write: if false; // backend Admin SDK handles writes
    }

    // Dashboard can read all active guardian sessions
    match /guardian_sessions/{sessionId} {
      allow read: if request.auth != null;
      allow write: if false; // backend Admin SDK handles writes
    }
  }
}
